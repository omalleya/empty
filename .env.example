# Copy to .env and fill in. Get these from https://developer.kroger.com
# (register an app; the client id/secret are per-app).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Must exactly match the Redirect URI registered on your Kroger app.
# For a local family tool, a loopback URI is easiest.
KROGER_REDIRECT_URI=http://localhost:8088/callback

# Default store. Find yours once via `python -m kroger.shopping_list --find-store <zip>`
# then paste the locationId here so you don't have to look it up every run.
KROGER_LOCATION_ID=

# For the LLM resolver. https://console.anthropic.com
ANTHROPIC_API_KEY=
